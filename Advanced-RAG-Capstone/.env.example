# Copy this file to ".env" and fill in your own values.
# The .env file is read automatically by config.py when the app starts.

# ===========================================================================
# LLM Provider Configuration
# Choose "gemini" (Default - Free), "groq" (Free), or "openai" (Paid)
# ===========================================================================
LLM_PROVIDER=gemini

# ---------------------------------------------------------------------------
# 1. Google Gemini (Recommended - Free Tier)
# Get your free key at: https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-1.5-flash

# ---------------------------------------------------------------------------
# 2. Embedding Model (Used for vector search)
# "huggingface" -> 100% FREE, runs locally on your PC (no API key needed!)
# "openai"      -> Remote OpenAI embeddings (requires paid OPENAI_API_KEY)
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=huggingface
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# 3. Optional Alternatives
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Vector database
# ---------------------------------------------------------------------------
# "faiss"    -> local files, no account needed (recommended, 100% free)
# "pinecone" -> remote vector database, needs the keys below
VECTOR_DB=faiss

# Only needed when VECTOR_DB=pinecone. Safe to leave empty for FAISS.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=advanced-rag
PINECONE_NAMESPACE=default

# ---------------------------------------------------------------------------
# Optional tuning (safe to leave as-is)
# ---------------------------------------------------------------------------
PARENT_CHUNK_SIZE=1600
PARENT_CHUNK_OVERLAP=200
CHILD_CHUNK_SIZE=400
CHILD_CHUNK_OVERLAP=60

NUM_QUERY_VARIANTS=3
VECTOR_TOP_K=6
BM25_TOP_K=6
HYBRID_TOP_K=10
RERANK_TOP_K=4
MIN_RERANK_SCORE=-4.0
MAX_CONTEXT_CHARS=8000
MEMORY_WINDOW=4

# Reranker: "cross-encoder" (accurate, needs sentence-transformers + PyTorch)
# or "simple" (keyword overlap, no extra packages).
RERANKER=cross-encoder
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
